            <size value="700px 30px"/>
        </Profile>

        <Profile name="irRowSection" extends="emptyPanel" with="anchorTopCenter">
            <size value="700px 24px"/>
        </Profile>

        <!-- ========== BACKGROUNDS ========== -->
        <Profile name="irSectionBg" extends="baseReference" with="anchorTopCenter">
            <size value="700px 30px"/>
            <imageColor value="0.08 0.08 0.12 0.9"/>
        </Profile>

        <Profile name="irSectionBgAlt" extends="baseReference" with="anchorTopCenter">
            <size value="700px 30px"/>
            <imageColor value="0.10 0.10 0.14 0.9"/>
        </Profile>

        <Profile name="irStatsBg" extends="baseReference" with="anchorTopCenter">
