            <imageColor value="0.12 0.14 0.10 0.9"/>
        </Profile>

        <Profile name="irHeaderBg" extends="baseReference" with="anchorTopCenter">
            <size value="700px 24px"/>
            <imageColor value="0.15 0.15 0.2 1"/>
